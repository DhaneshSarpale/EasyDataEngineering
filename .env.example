# ==================================================================
# DataForge - example environment variables
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# In AWS these are provided via Secrets Manager / task roles instead.
# ==================================================================

# Which environment config to load: dev | prod
DATAFORGE_ENV=dev

# AWS (LOCAL MODE does not need these). Prefer OIDC / instance roles in CI/CD.
AWS_REGION=eu-west-1
# AWS_PROFILE=dataforge-dev

# Source database (AWS MODE only; LOCAL MODE uses SQLite)
SOURCE_DB_HOST=
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=dataforge
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=

# Mock API auth token (LOCAL MODE). The mock API accepts this token.
DATAFORGE_API_TOKEN=local-dev-token

# SFTP credentials (LOCAL MODE demo)
SFTP_PASSWORD=dataforge-local
