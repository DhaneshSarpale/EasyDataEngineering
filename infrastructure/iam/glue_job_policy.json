{
  "_comment": "Least-privilege policy for the Glue ETL role (reference; the live version is generated by infrastructure/terraform/modules/iam). Scoped to the dev lake buckets + KMS key. Replace ARNs per environment.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LakeReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::dataforge-dev-raw", "arn:aws:s3:::dataforge-dev-raw/*",
        "arn:aws:s3:::dataforge-dev-bronze", "arn:aws:s3:::dataforge-dev-bronze/*",
        "arn:aws:s3:::dataforge-dev-silver", "arn:aws:s3:::dataforge-dev-silver/*",
        "arn:aws:s3:::dataforge-dev-gold", "arn:aws:s3:::dataforge-dev-gold/*",
        "arn:aws:s3:::dataforge-dev-quarantine", "arn:aws:s3:::dataforge-dev-quarantine/*"
      ]
    },
    {
      "Sid": "UseKmsKey",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "arn:aws:kms:eu-west-1:000000000000:key/REPLACE_WITH_KEY_ID"
    },
    {
      "Sid": "GlueCatalog",
      "Effect": "Allow",
      "Action": ["glue:GetTable", "glue:GetPartition*", "glue:BatchCreatePartition", "glue:UpdateTable"],
      "Resource": "*"
    },
    {
      "Sid": "GlueLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:eu-west-1:000000000000:log-group:/aws-glue/*"
    }
  ]
}
