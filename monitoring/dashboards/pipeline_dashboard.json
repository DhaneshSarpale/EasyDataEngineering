{
  "_comment": "CloudWatch dashboard body for the DataForge pipeline. Import via the console (Actions > View/edit source) or apply with the monitoring Terraform module. KPIs: job health, records processed/failed, streaming lag, API failures.",
  "widgets": [
    {
      "type": "metric", "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Glue tasks: completed vs failed",
        "region": "eu-west-1",
        "stat": "Sum", "period": 300,
        "metrics": [
          ["Glue", "glue.driver.aggregate.numCompletedTasks", "JobName", "transactions_bronze_to_silver", "Type", "count"],
          ["Glue", "glue.driver.aggregate.numFailedTasks", "JobName", "transactions_bronze_to_silver", "Type", "count"]
        ]
      }
    },
    {
      "type": "metric", "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Kinesis stream: incoming records & iterator age (lag)",
        "region": "eu-west-1", "period": 60,
        "metrics": [
          ["AWS/Kinesis", "IncomingRecords", "StreamName", "dataforge-dev-transactions"],
          ["AWS/Kinesis", "GetRecords.IteratorAgeMilliseconds", "StreamName", "dataforge-dev-transactions"]
        ]
      }
    },
    {
      "type": "metric", "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Lambda errors & duration (api_ingestion)",
        "region": "eu-west-1", "period": 300,
        "metrics": [
          ["AWS/Lambda", "Errors", "FunctionName", "dataforge-dev-api-ingestion", { "stat": "Sum" }],
          ["AWS/Lambda", "Duration", "FunctionName", "dataforge-dev-api-ingestion", { "stat": "Average" }]
        ]
      }
    },
    {
      "type": "metric", "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Step Functions executions",
        "region": "eu-west-1", "period": 300, "stat": "Sum",
        "metrics": [
          ["AWS/States", "ExecutionsSucceeded", "StateMachineArn", "arn:aws:states:eu-west-1:000000000000:stateMachine:dataforge-dev-daily"],
          ["AWS/States", "ExecutionsFailed", "StateMachineArn", "arn:aws:states:eu-west-1:000000000000:stateMachine:dataforge-dev-daily"]
        ]
      }
    }
  ]
}
